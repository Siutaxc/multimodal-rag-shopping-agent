# Shared runtime profile
SHOPLENS_APP_ENV=development
SHOPLENS_LOG_LEVEL=INFO
SHOPLENS_CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SHOPLENS_DEPENDENCY_TIMEOUT_SECONDS=2
SHOPLENS_CACHE_ENABLED=true
SHOPLENS_CACHE_TTL_SECONDS=60
SHOPLENS_CACHE_NAMESPACE=stage8-v1
SHOPLENS_RATE_LIMIT_ENABLED=true
SHOPLENS_RATE_LIMIT_REQUESTS=120
SHOPLENS_RATE_LIMIT_WINDOW_SECONDS=60
SHOPLENS_PROVIDER_RETRY_ATTEMPTS=3
SHOPLENS_PROVIDER_RETRY_BACKOFF_SECONDS=0.05
SHOPLENS_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
SHOPLENS_CIRCUIT_BREAKER_RECOVERY_SECONDS=30
SHOPLENS_SLOW_QUERY_THRESHOLD_MS=100

# Host ports
SHOPLENS_WEB_BIND=127.0.0.1
SHOPLENS_API_BIND=127.0.0.1
SHOPLENS_POSTGRES_BIND=127.0.0.1
SHOPLENS_REDIS_BIND=127.0.0.1
SHOPLENS_WEB_PORT=3000
SHOPLENS_API_PORT=8000
SHOPLENS_POSTGRES_PORT=5432
SHOPLENS_REDIS_PORT=6379

# Local database and cache
SHOPLENS_POSTGRES_USER=shoplens
SHOPLENS_POSTGRES_PASSWORD=shoplens
SHOPLENS_POSTGRES_DB=shoplens
SHOPLENS_DATABASE_URL=postgresql://shoplens:shoplens@127.0.0.1:5432/shoplens
SHOPLENS_REDIS_URL=redis://127.0.0.1:6379/0
SHOPLENS_OBJECT_STORAGE_PATH=data/storage

# Stage 4 text retrieval. Fixture providers are deterministic and offline.
SHOPLENS_EMBEDDING_PROVIDER=fixture
SHOPLENS_EMBEDDING_MODEL_NAME=BAAI/bge-m3
SHOPLENS_EMBEDDING_MODEL_VERSION=fixture-semantic-v1
SHOPLENS_EMBEDDING_DIMENSION=1024
SHOPLENS_EMBEDDING_BATCH_SIZE=16
SHOPLENS_EMBEDDING_TIMEOUT_SECONDS=10
# SHOPLENS_EMBEDDING_ENDPOINT=https://provider.example/v1/embeddings
# SHOPLENS_EMBEDDING_API_KEY=
SHOPLENS_RERANKER_PROVIDER=fixture
SHOPLENS_RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
SHOPLENS_RERANKER_MODEL_VERSION=fixture-semantic-v1
SHOPLENS_RERANKER_TIMEOUT_SECONDS=2
# SHOPLENS_RERANKER_ENDPOINT=https://provider.example/v1/rerank
# SHOPLENS_RERANKER_API_KEY=
SHOPLENS_LEXICAL_CANDIDATE_K=50
SHOPLENS_DENSE_CANDIDATE_K=50
SHOPLENS_FUSION_CANDIDATE_K=30
SHOPLENS_RERANK_TOP_K=30
SHOPLENS_RRF_K=60

# Stage 5 image retrieval. Fixture mode is a deterministic pixel encoder, not real SigLIP2.
SHOPLENS_IMAGE_EMBEDDING_PROVIDER=fixture
SHOPLENS_IMAGE_EMBEDDING_MODEL_NAME=google/siglip2-base-patch16-224
SHOPLENS_IMAGE_EMBEDDING_MODEL_VERSION=fixture-visual-v1
SHOPLENS_IMAGE_EMBEDDING_DIMENSION=768
SHOPLENS_IMAGE_EMBEDDING_BATCH_SIZE=16
SHOPLENS_IMAGE_EMBEDDING_TIMEOUT_SECONDS=10
# SHOPLENS_IMAGE_EMBEDDING_ENDPOINT=https://provider.example/v1/image-embeddings
# SHOPLENS_IMAGE_EMBEDDING_API_KEY=
SHOPLENS_IMAGE_CANDIDATE_K=50
SHOPLENS_MULTIMODAL_TEXT_WEIGHT=1.0
SHOPLENS_MULTIMODAL_IMAGE_WEIGHT=1.25
SHOPLENS_IMAGE_UPLOAD_MAX_BYTES=5242880
SHOPLENS_IMAGE_UPLOAD_MAX_PIXELS=20000000
SHOPLENS_IMAGE_UPLOAD_MAX_DIMENSION=4096

# Stage 6 bounded shopping agent. Fixture mode is deterministic and offline.
SHOPLENS_AGENT_PROVIDER=fixture
SHOPLENS_AGENT_MODEL_NAME=shoplens/bounded-shopping-agent
SHOPLENS_AGENT_MODEL_VERSION=fixture-rules-v1
SHOPLENS_AGENT_TIMEOUT_SECONDS=4
SHOPLENS_AGENT_MAX_TOOL_STEPS=4
SHOPLENS_AGENT_RESULT_LIMIT=3
SHOPLENS_AGENT_SESSION_TTL_SECONDS=86400
SHOPLENS_AGENT_TRACE_TTL_SECONDS=86400
# SHOPLENS_AGENT_ENDPOINT=https://provider.example/v1/chat/completions
# SHOPLENS_AGENT_API_KEY=

# Browser-visible API URL. HTTP is intentional for local development.
NEXT_PUBLIC_SHOPLENS_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SHOPLENS_SITE_URL=http://localhost:3000
